{
  "name": "music-automation",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Startup-story-to-song pipeline: lyrics -> AI music/vocals -> lyric video -> multi-platform posting, for InnoVexis Consulting / Dare to Law founder-brand content. Self-contained: copy this folder into any repo and it works standalone.",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "pipeline:run": "tsx src/orchestrator/run-once.ts",
    "pipeline:daemon": "tsx src/orchestrator/daemon.ts",
    "cli": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "oauth:youtube": "tsx scripts/youtube-oauth.mjs",
    "oauth:soundcloud": "tsx scripts/soundcloud-oauth.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "dotenv": "^16.4.5",
    "fluent-ffmpeg": "^2.1.3",
    "googleapis": "^144.0.0",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1",
    "sharp": "^0.33.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
