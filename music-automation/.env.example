# ============================================================================
# music-automation — environment configuration
#
# Copy to `.env` for local runs, or set these as GitHub Actions "Repository
# secrets" / "Repository variables" (Settings -> Secrets and variables ->
# Actions) if you're running this on the included scheduled workflow, or as
# systemd EnvironmentFile / Docker env if self-hosting on a VM.
#
# Nothing in this file is a real secret. Every value below is either blank
# or a safe default.
# ============================================================================

# --- LLM (lyrics generation) --------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Cheapest model that reliably returns structured JSON. Swap to a bigger
# model only if lyric quality needs it -- this is the single biggest lever
# for keeping per-song LLM cost near-zero.
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Music + vocal generation --------------------------------------------
# Primary, fully-automatable provider as of 2026: ElevenLabs Music API.
# Requires a paid ElevenLabs plan (Music API is not on the free tier).
# https://elevenlabs.io/app/developers/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=music_v2
# Optional: path to a ~30s local audio file (mp3/wav) used as a style
# reference for generation (genre/tempo/mood), NOT lyrics or vocal cloning.
# See README "Attaching an MP3 reference track".
MUSIC_REFERENCE_AUDIO_PATH=

# Experimental / unofficial fallback ONLY -- Suno has no public self-serve
# API as of 2026 (partner program only, see README). Leave unset unless you
# have specifically vetted a provider and accepted the ToS risk yourself.
MUSIC_PROVIDER=elevenlabs
SUNO_API_KEY=
SUNO_API_BASE_URL=

# --- Video assembly (ffmpeg, always free/local, no API) -----------------
COVER_TITLE_FONT_COLOR=#ffffff
COVER_BACKGROUND_COLOR_FROM=#0f172a
COVER_BACKGROUND_COLOR_TO=#312e81
ASSETS_DIR=./assets

# --- YouTube (direct API, fully automatable after one-time OAuth) -------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY_STATUS=public

# --- LinkedIn / Instagram / X / Facebook / TikTok / Threads / etc -------
# Pick ONE social publisher backend:
#   buffer  -> Buffer's official GraphQL API, free plan, personal API key
#              (good default: zero infra, no self-hosting)
#   postiz  -> self-hosted Postiz (open source, AGPL-3, $0 forever) --
#              see README "Free self-hosted alternative"
SOCIAL_PUBLISHER=buffer

# Buffer (https://publish.buffer.com/settings/api)
BUFFER_ACCESS_TOKEN=
BUFFER_CHANNEL_IDS=

# Postiz (self-hosted instance you control, or Postiz Cloud)
POSTIZ_BASE_URL=http://localhost:5000
POSTIZ_API_KEY=
POSTIZ_INTEGRATION_IDS=

# --- SoundCloud (self-serve API as of 2026, requires Artist Pro) --------
# See README for the current status and the one-time OAuth helper script.
SOUNDCLOUD_ENABLED=false
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
SOUNDCLOUD_ACCESS_TOKEN=
SOUNDCLOUD_REFRESH_TOKEN=

# --- Human review gate (recommended) -------------------------------------
SLACK_WEBHOOK_URL=
# Set true for fully unattended operation (skips the Slack approval tap and
# auto-publishes). Off by default -- see README "Zero-human-intervention mode".
AUTO_APPROVE=false

# --- Database -------------------------------------------------------------
# Leave blank to use the zero-dependency, zero-cost default: a plain JSON
# file at DB_FILE_PATH, committed back to git by the GitHub Actions workflow
# so state survives between runs for free (and stays human-readable in a
# `git diff`). Set DATABASE_URL to a real Postgres connection string (e.g. a
# free Neon or Supabase project) to use that instead -- no code changes needed.
DATABASE_URL=
DB_FILE_PATH=./data/songs.json

# --- Cost guardrails (mirrors the cost ledger pattern used elsewhere in
# this account's repos) -----------------------------------------------------
MAX_SONGS_PER_RUN=3
MAX_MONTHLY_COST_CENTS=5000

# --- Source themes to turn into songs (comma-separated) -------------------
SOURCE_THEMES=Dare to Law,Innovexsis Consulting
