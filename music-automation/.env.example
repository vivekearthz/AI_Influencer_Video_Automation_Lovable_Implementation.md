# ============================================================================
# music-automation — environment configuration
#
# Every default below is a genuinely free tool: no credit card, no paid
# plan required anywhere in this file. Copy to `.env` for local runs, or
# set these as GitHub Actions "Repository secrets" / "Repository variables"
# (Settings -> Secrets and variables -> Actions) for the scheduled workflow.
#
# Nothing in this file is a real secret. Every value below is either blank
# or a safe default.
# ============================================================================

# --- Lyrics (free LLM, no credit card) -----------------------------------
# Default: Groq's free tier (console.groq.com/keys -- sign up, no card).
# Also works unmodified against your own OmniBridge deployment
# (LYRICS_API_BASE_URL = https://<your-omnibridge>.vercel.app/api/v1), or
# Google Gemini's/OpenRouter's OpenAI-compatible free endpoints.
LYRICS_API_BASE_URL=https://api.groq.com/openai/v1
LYRICS_API_KEY=
LYRICS_MODEL=llama-3.3-70b-versatile

# --- Music + vocals (free, open-source, self-hostable) --------------------
# Default: the official public ACE-Step Hugging Face Space (free shared
# GPU via HF's ZeroGPU program) -- no signup, no API key required.
# HF_TOKEN is optional and only improves rate limits on the shared Space
# (create one free at huggingface.co/settings/tokens).
# For guaranteed availability / no queueing, self-host ACE-Step on your
# own GPU and point ACE_STEP_BASE_URL at it instead -- see README.
ACE_STEP_BASE_URL=https://ace-step-ace-step.hf.space
HF_TOKEN=
ACE_STEP_DURATION_SECONDS=120
ACE_STEP_INFER_STEPS=60

# --- Video assembly (ffmpeg, always free/local, no API) -----------------
COVER_TITLE_FONT_COLOR=#ffffff
COVER_BACKGROUND_COLOR_FROM=#0f172a
COVER_BACKGROUND_COLOR_TO=#312e81
ASSETS_DIR=./assets

# --- YouTube (direct API, free, fully automatable after one-time OAuth) -
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY_STATUS=public

# --- LinkedIn / Instagram / X / Facebook / TikTok / Threads / etc -------
# Pick ONE social publisher backend, both are free:
#   buffer  -> Buffer's free plan + personal API key (zero self-hosting)
#   postiz  -> self-hosted Postiz (open source, $0 forever, more platforms)
SOCIAL_PUBLISHER=buffer

# Buffer (https://publish.buffer.com/settings/api)
BUFFER_ACCESS_TOKEN=
BUFFER_CHANNEL_IDS=

# Postiz (self-hosted instance you control, or Postiz Cloud)
POSTIZ_BASE_URL=http://localhost:5000
POSTIZ_API_KEY=
POSTIZ_INTEGRATION_IDS=

# --- SoundCloud (optional -- the one channel with no free path) ---------
# SoundCloud's self-serve API requires an active Artist Pro subscription.
# There is no free alternative for SoundCloud specifically -- leave this
# off (default) and treat it as a channel you skip, or pay for it later.
SOUNDCLOUD_ENABLED=false
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
SOUNDCLOUD_ACCESS_TOKEN=
SOUNDCLOUD_REFRESH_TOKEN=

# --- Human review gate (recommended, all channels optional & free) ------
SLACK_WEBHOOK_URL=

# Free SMTP email (Gmail App Password, Zoho Free, Brevo, Resend SMTP -- see README)
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=

# WhatsApp via Meta's official Cloud API (API access is free; see README
# for the one caveat: unprompted notifications cost a fraction of a cent
# each unless sent inside a customer-initiated 24h window)
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TO_NUMBER=

# Set true for fully unattended operation (skips every review-gate
# notification above and auto-publishes). Off by default -- see README
# "Zero-human-intervention mode".
AUTO_APPROVE=false

# --- Database (free either way) -------------------------------------------
# Leave blank to use the zero-dependency default: a local JSON file at
# DB_FILE_PATH, committed back to git by the GitHub Actions workflow so
# state survives between runs for free. Set DATABASE_URL to a free-tier
# Postgres connection string (e.g. Neon) to use that instead.
DATABASE_URL=
DB_FILE_PATH=./data/songs.json

# --- Cost guardrails (kept even though the default stack is $0, so a bug
# can't quietly rack up usage if you ever swap in a paid provider) --------
MAX_SONGS_PER_RUN=3
MAX_MONTHLY_COST_CENTS=5000

# --- Source themes to turn into songs (comma-separated) -------------------
SOURCE_THEMES=Dare to Law,Innovexsis Consulting
