# -----------------------------------------------------------------------------
# Frontend (Vite) — safe to expose in the browser bundle. Never put Razorpay
# secret keys in a VITE_-prefixed variable; those live only as Supabase Edge
# Function secrets.
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SITE_URL=https://influenceos.example.com

# -----------------------------------------------------------------------------
# Supabase Edge Function secrets (server-side only).
# Set with: supabase secrets set --env-file .env.functions
# -----------------------------------------------------------------------------

# --- Razorpay (subscriptions + escrow) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# One plan id per brand subscription tier (create these in the Razorpay dashboard):
RAZORPAY_PLAN_ID_STARTER=
RAZORPAY_PLAN_ID_GROWTH=
RAZORPAY_PLAN_ID_SCALE=

# --- Render worker / Edge Function service role access ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
