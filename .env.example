# -----------------------------------------------------------------------------
# Frontend (Vite) — safe to expose in the browser bundle.
# NEVER put provider secret keys (Gemini, ElevenLabs, Meta, LinkedIn, etc.) in
# any VITE_-prefixed variable. Those must live only as Supabase Edge Function
# secrets (see supabase/functions/*/README or `supabase secrets set`).
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_DEFAULT_WORKSPACE_TIMEZONE=Asia/Kolkata

# -----------------------------------------------------------------------------
# Supabase Edge Function secrets (server-side only).
# Set with: supabase secrets set --env-file .env.functions
# Only configure the providers you actually use — the provider registry will
# mark anything else as "not configured" rather than pretending it works.
# -----------------------------------------------------------------------------

# --- Text / script / captions / QC ---
GEMINI_API_KEY=

# --- Video generation (Veo via Gemini API) ---
# Same key as GEMINI_API_KEY is normally reused; kept separate for clarity /
# in case a different Google Cloud project is used for video.
VEO_API_KEY=

# --- Voice / TTS ---
ELEVENLABS_API_KEY=

# --- Avatar / lip-sync (optional, future provider) ---
KLING_API_KEY=

# --- Meta (Instagram / Facebook) ---
META_APP_ID=
META_APP_SECRET=

# --- LinkedIn ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- YouTube (Google OAuth) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# --- TikTok ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- X (Twitter) ---
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- Approved third-party publisher (Ayrshare/Buffer/Publer/Metricool style) ---
THIRD_PARTY_PUBLISHER_PROVIDER=
THIRD_PARTY_PUBLISHER_API_KEY=

# --- Email ---
EMAIL_PROVIDER=resend
EMAIL_PROVIDER_KEY=
EMAIL_FROM_ADDRESS=

# --- WhatsApp Cloud API ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --- Webhook signature secrets ---
WEBHOOK_SIGNING_SECRET=

# --- Render worker (Node/FFmpeg background worker, deployed separately from
#     Supabase Edge Functions since Edge Functions cannot shell out to ffmpeg) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RENDER_WORKER_POLL_INTERVAL_MS=5000
